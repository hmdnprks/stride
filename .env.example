# Copy to .env.local for local development, and set the same variables in your
# hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# --- Password gate -----------------------------------------------------------
# Required once deployed: without it, a deployed Stride stays locked.
# Optional locally: with no password in development, the site stays open.
# Use a long, random value. Changing it signs every browser out.
STRIDE_PASSWORD=

# --- Time zone ---------------------------------------------------------------
# Your time zone, as an IANA name (e.g. Asia/Jakarta, Europe/London).
# Needed when deployed: servers run in UTC, so "today", weeks, months and the
# "Synced at" time would otherwise be off by your UTC offset. Optional locally.
STRIDE_TIMEZONE=

# --- Database: Upstash Redis -------------------------------------------------
# Stores your Garmin session, goals and sign-ins waiting for a code.
# Vercel's Upstash integration adds these for you, with the prefix you chose
# when connecting the store (here "STRIDE_STORAGE_"). Stride reads any
# <prefix>KV_REST_API_URL with its matching <prefix>KV_REST_API_TOKEN.
STRIDE_STORAGE_KV_REST_API_URL=
STRIDE_STORAGE_KV_REST_API_TOKEN=

# Also added by the integration; Stride doesn't use them.
STRIDE_STORAGE_KV_REST_API_READ_ONLY_TOKEN=
STRIDE_STORAGE_KV_URL=
STRIDE_STORAGE_REDIS_URL=

# Alternative if you created the database on upstash.com directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Locally you can leave the database empty: data is then kept in .stride/kv.json.
